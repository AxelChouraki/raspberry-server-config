#!/usr/bin/env python3
# {{ ansible_managed }}
"""Envoie le rapport Logwatch sur Discord (lancé par cron, en root)."""
import socket
import subprocess
import sys

import requests

WEBHOOK_URL = "{{ discord_webhook_url }}"
AVATAR_URL = "https://i.imgur.com/4M34hi2.png"
CHUNK_SIZE = 1900  # Discord refuse les messages de plus de 2000 caractères
HOST = socket.gethostname()


def send(username, content):
    response = requests.post(
        WEBHOOK_URL,
        json={"username": username, "avatar_url": AVATAR_URL, "content": content},
        timeout=30,
    )
    if response.status_code >= 300:
        print("Échec de l'envoi ({}) : {}".format(response.status_code, response.text))
        return False
    return True


report = subprocess.check_output(["/usr/sbin/logwatch", "--output", "stdout"]).decode("utf-8", "replace")
chunks = [report[i:i + CHUNK_SIZE] for i in range(0, len(report), CHUNK_SIZE)]

ok = True
for index, chunk in enumerate(chunks, start=1):
    ok &= send("Logs {} ({}/{})".format(HOST, index, len(chunks)), "```\n{}\n```".format(chunk))

ok &= send("Logs {}".format(HOST), "Rapport Logwatch complet envoyé.")
sys.exit(0 if ok else 1)
