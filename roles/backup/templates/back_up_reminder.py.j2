#!/usr/bin/env python3
# {{ ansible_managed }}
"""Rappel mensuel de sauvegarde, envoyé sur Discord."""
import socket
import sys

import requests

WEBHOOK_URL = "{{ discord_webhook_url }}"

response = requests.post(
    WEBHOOK_URL,
    json={
        "username": "Friendly Reminder ({})".format(socket.gethostname()),
        "content": {{ backup_reminder_message | to_json }},
    },
    timeout=30,
)

if response.status_code >= 300:
    print("Échec de l'envoi du rappel ({}) : {}".format(response.status_code, response.text))
    sys.exit(1)
print("Rappel envoyé.")
